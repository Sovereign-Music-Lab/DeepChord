# Deny by default; only reviewed source paths are eligible for version control.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/pyproject.toml
!/Start.command
!/AGENTS.md
!/src/
!/tests/
!/scripts/
!/docs/
!/.github/
__pycache__/
*.pyc
*.pdf
*.sqlite*
*.db
*.jsonl
*.safetensors
*.gguf
*.bin
*.npz
*.npy
*.pt
*.pth
*.ckpt
*.onnx
*.mid
*.midi
*.wav
*.mp3
*.logicx/
.env*
.DS_Store
*.egg-info/
!/MANIFEST.in
